# --- AI: "deepseek", "claude" or "gemini" ---
PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional if you use Claude or Gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Shop configuration ---
SHOP_TIMEZONE=America/Bogota
SHOP_NAME=Fade Factory

# --- WhatsApp Cloud API (optional: simulator works without it) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ADMIN_TOKEN=
