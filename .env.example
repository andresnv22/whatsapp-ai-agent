# --- AI: "claude" or "gemini" ---
PROVIDER=claude
ANTHROPIC_API_KEY=paste-your-key-here
# Only needed if PROVIDER=gemini
GEMINI_API_KEY=

# --- WhatsApp Cloud API (leave empty to run in local simulator mode) ---
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; you type the same one in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# App secret (Meta app > Settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
